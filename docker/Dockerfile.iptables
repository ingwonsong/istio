# hadolint ignore=DL3026
FROM gke.gcr.io/gke-distroless/libc:gke_distroless_20250507.00_p0@sha256:fdc0b952d957cc99179df5141eb3d61cfc64b0a4312b72b12208b9273c8db41f AS distroless_libc

# hadolint ignore=DL3026
FROM us.gcr.io/gke-release/debian-base:bookworm-v1.0.4-gke.7@sha256:138deac95514f1b91bec40c09a5a091a6a1953cea0806be15b43897cc9d3172e AS pkgs

ARG PKGS="ca-certificates-bundle iptables ip6tables libnetfilter_conntrack libnfnetlink libmnl"

WORKDIR /tmp

# hadolint ignore=DL4006,SC2086
RUN apt-get update \
    && apt-get download $(apt-cache depends --recurse -i ${PKGS} | grep '^\w') \
    && mkdir -p /dpkg/var/lib/dpkg/status.d/ \
    && for deb in *.deb; do \
        package_name=$(dpkg-deb -I ${deb} | awk '/^ Package: .*$/ {print $2}'); \
        dpkg --ctrl-tarfile $deb | tar -Oxf - ./control > /dpkg/var/lib/dpkg/status.d/${package_name}; \
        dpkg --extract $deb /dpkg || exit 10; \
    done \
    && find /dpkg/ -type d -empty -delete \
    && rm -r /dpkg/usr/share/doc/ \
    && find /dpkg/

WORKDIR /dpkg/usr/sbin/
RUN mkdir /dpkg/run && chmod 755 /dpkg/run

RUN ln -s iptables-legacy iptables \
    && ln -s iptables-legacy-restore iptables-restore \
    && ln -s iptables-legacy-save iptables-save \
    && ln -s ip6tables-legacy ip6tables \
    && ln -s ip6tables-legacy-restore ip6tables-restore \
    && ln -s ip6tables-legacy-save ip6tables-save

FROM distroless_libc
COPY --from=pkgs ["/dpkg/", "/"]

USER 65532
